---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import CartDrawer from '../../components/CartDrawer.astro';
import { products, catalog, delivery } from '../../content/site';

export function getStaticPaths() {
  return products.map((p) => ({ params: { id: p.id }, props: { p } }));
}
const { p } = Astro.props;
const others = products.filter((x) => x.id !== p.id).slice(0, 4);
---
<Base title={p.name} description={p.text}>
  <Nav />
  <main id="main" class="wrap">
    <div class="shell">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a> <span>/</span> <a href="/catalog/">Каталог</a> <span>/</span> <b>{p.name}</b>
      </nav>

      <div class="prod">
        <figure class="shot">
          <img src={p.photo} alt={p.name} width="900" height="1200" fetchpriority="high" decoding="async" />
        </figure>

        <div class="info">
          <p class="label">{p.category}</p>
          <h1 class="h1 name">{p.name}</h1>
          <p class="price numeral"><span data-live-price>
            {p.price.toLocaleString('ru')} ₽
            </span>
            <s class="old numeral" data-live-old hidden={!p.oldPrice}>{p.oldPrice ? `${p.oldPrice.toLocaleString('ru')} ₽` : ''}</s>
          </p>
          <p class="lead text">{p.text}</p>

          <fieldset class="sizes">
            <legend>{catalog.sizeLabel}</legend>
            <div class="chips">
              {p.sizes.map((sz) => {
                const left = p.stock[sz] ?? 0;
                return (
                  <label class={`chip${left === 0 ? ' out' : ''}`}>
                    <input type="radio" name="size" value={sz} disabled={left === 0} />
                    <span>{sz}{left === 0 ? <i class="few">нет</i> : left <= 3 ? <i class="few">осталось {left}</i> : null}</span>
                  </label>
                );
              })}
            </div>
          </fieldset>

          <button class="btn btn-primary press add" data-add data-id={p.id}
            data-label={catalog.add} data-done={catalog.added}>{catalog.add}</button>

          <!-- Доверие рядом с кнопкой, а не в подвале: решение купить
               принимается именно здесь, и именно здесь нужны ответы
               «а если не подойдёт» и «а вернут ли деньги». -->
          <ul class="trust">
            <li>Обмен и возврат 30 дней, деньги возвращаем на карту</li>
            <li>Оплата переводом по СБП или наличными курьеру — без комиссии</li>
            <li>Доставка по Москве на следующий день</li>
          </ul>

          <dl class="specs">
            <div><dt>Цвет</dt><dd>{p.colour}</dd></div>
            <div><dt>Состав</dt><dd>{p.composition}</dd></div>
            <div><dt>Доставка</dt><dd>Бесплатно, при любой сумме заказа</dd></div>
            <div><dt>Обмен</dt><dd>30 дней с момента получения</dd></div>
          </dl>
        </div>
      </div>

      <section class="more">
        <h2 class="h2">Ещё из каталога</h2>
        <div class="more-grid">
          {others.map((o) => (
            <a class="mini" href={`/product/${o.id}/`} data-reveal-soft>
              <span class="mini-shot"><img src={o.photo} alt={o.name} width="900" height="1200" loading="lazy" /></span>
              <span class="mini-row"><b>{o.name}</b><span class="numeral">{o.price.toLocaleString('ru')} ₽</span></span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </main>
  <div class="buybar" data-buybar>
    <span class="buybar-price numeral" data-live-price>{p.price.toLocaleString('ru')} ₽</span>
    <button class="btn btn-primary press buybar-btn" data-add-sticky>{catalog.add}</button>
  </div>
  <Footer />
  <CartDrawer />
</Base>

<style>
  .wrap { padding-block: 28px 0; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.84rem; color: var(--color-faint); margin-bottom: 26px; }
  .crumbs a { text-decoration: none; color: var(--color-muted); }
  .crumbs a:hover { color: var(--color-azure); }
  .crumbs b { font-weight: 400; color: var(--color-ink); }

  .prod { display: grid; gap: 30px; }
  .shot { margin: 0; border-radius: var(--radius-card); overflow: hidden; background: var(--color-mist); }
  .shot img { width: 100%; height: auto; aspect-ratio: 3 / 4; object-fit: cover; }

  .info { display: grid; gap: 16px; align-content: start; }
  .name { margin-top: 8px; }
  .price { font-size: 1.5rem; font-weight: 500; }
  .old { color: var(--color-faint); font-weight: 400; font-size: 1rem; margin-left: 10px; }
  .text { max-width: 46ch; }

  .sizes { border: 0; padding: 0; margin: 0; }
  .sizes legend { font-size: 0.78rem; color: var(--color-muted); padding: 0 0 8px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip input { position: absolute; opacity: 0; pointer-events: none; }
  .chip span {
    display: flex; align-items: center; justify-content: center;
    min-width: 52px; min-height: 46px; padding: 0 14px;
    border: 1px solid var(--color-line); border-radius: var(--radius-soft);
    font-size: 0.9rem; cursor: pointer;
    transition: border-color var(--dur-micro) var(--ease-out-soft), background-color var(--dur-micro) var(--ease-out-soft);
  }
  .chip input:checked + span { border-color: var(--color-ink); background: var(--color-ink); color: var(--color-canvas); }
  .chip input:focus-visible + span { outline: 2px solid var(--color-azure); outline-offset: 2px; }

  .add { justify-content: center; min-height: 54px; }
  .add.done { background: var(--color-azure-deep); }

  .chip.out span { color: var(--color-faint); text-decoration: line-through; background: var(--color-surface); cursor: not-allowed; }
  .chip .few { font-style: normal; font-size: 0.66rem; color: var(--color-muted); margin-left: 6px; }

  .trust { list-style: none; padding: 0; margin: 2px 0 0; display: grid; gap: 7px; }
  .trust li { position: relative; padding-left: 22px; font-size: 0.84rem; color: var(--color-muted); }
  .trust li::before {
    content: ''; position: absolute; left: 0; top: 6px;
    width: 12px; height: 7px; border-left: 2px solid var(--color-azure);
    border-bottom: 2px solid var(--color-azure); transform: rotate(-45deg);
  }

  /* Липкая покупка. Страница товара — 3.2 экрана, и кнопка была только
     наверху: долистав до похожих товаров, купить было нельзя. */
  .buybar {
    position: fixed; left: 0; right: 0; bottom: 0; z-index: 70;
    display: flex; align-items: center; gap: 12px;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in oklab, var(--color-canvas) 92%, transparent);
    backdrop-filter: blur(14px); border-top: 1px solid var(--color-line);
    transform: translateY(115%); transition: transform 380ms var(--ease-out-soft);
  }
  .buybar.is-in { transform: translateY(0); }
  .buybar-price { font-size: 1.05rem; font-weight: 500; white-space: nowrap; }
  .buybar-btn { flex: 1; justify-content: center; min-height: 48px; }
  @media (min-width: 900px) { .buybar { display: none; } }

  .specs { display: grid; gap: 12px; margin-top: 6px; padding-top: 20px; border-top: 1px solid var(--color-hairline); }
  .specs > div { display: grid; grid-template-columns: 120px 1fr; gap: 14px; }
  .specs dt { font-size: 0.84rem; color: var(--color-faint); }
  .specs dd { font-size: 0.92rem; }

  .more { padding-block: var(--space-section); }
  .more-grid { display: grid; gap: 22px 16px; grid-template-columns: repeat(2, 1fr); margin-top: 28px; }
  .mini { text-decoration: none; display: grid; gap: 10px; }
  .mini-shot { display: block; overflow: hidden; border-radius: var(--radius-card); background: var(--color-mist); aspect-ratio: 3 / 4; }
  .mini-shot img { width: 100%; height: 100%; object-fit: cover; transition: transform 700ms var(--ease-out-soft); }
  @media (hover: hover) { .mini:hover .mini-shot img { transform: scale(1.04); } }
  .mini-row { display: flex; justify-content: space-between; gap: 10px; font-size: 0.92rem; }
  .mini-row b { font-weight: 500; }

  @media (min-width: 900px) {
    .prod { grid-template-columns: 1.05fr 0.95fr; gap: 60px; align-items: start; }
    .more-grid { grid-template-columns: repeat(4, 1fr); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { add } from '../../scripts/cart';

  const btn = document.querySelector('[data-add]') as HTMLButtonElement | null;

  /* Первый доступный размер отмечаем сразу: если по умолчанию отмечен
     закончившийся, человек жмёт «в корзину» и получает отказ без объяснения. */
  const firstFree = document.querySelector('input[name="size"]:not([disabled])') as HTMLInputElement | null;
  if (firstFree && !document.querySelector('input[name="size"]:checked')) firstFree.checked = true;

  const currentSize = () =>
    (document.querySelector('input[name="size"]:checked') as HTMLInputElement | null)?.value ?? '';

  /* Липкая полоса появляется, когда основная кнопка ушла с экрана,
     и не мешает, пока она видна. */
  const bar = document.querySelector('[data-buybar]') as HTMLElement | null;
  if (bar && btn) {
    new IntersectionObserver(([e]) => bar.classList.toggle('is-in', !e.isIntersecting), { threshold: 0 }).observe(btn);
  }
  document.querySelector('[data-add-sticky]')?.addEventListener('click', () => btn?.click());

  btn?.addEventListener('click', () => {
    const size = currentSize();
    if (!size) return;
    add(btn.dataset.id!, size);
    // Подтверждение прямо на нажатой кнопке: человек не должен искать
    // глазами, случилось ли что-то.
    btn.classList.add('done');
    btn.textContent = btn.dataset.done!;
    gsap.fromTo(btn, { scale: 0.97 }, { scale: 1, duration: 0.34, ease: 'back.out(2.4)' });
    window.setTimeout(() => {
      btn.classList.remove('done');
      btn.textContent = btn.dataset.label!;
    }, 1400);
  });

  /* Артикул берём из адреса, а не из переменной сборки: скрипт лежит
     в отдельном файле и о содержимом страницы ничего не знает. */
  import('../../scripts/live').then((m) =>
    m.syncProduct(location.pathname.split('/').filter(Boolean).pop() || ''),
  );
</script>
